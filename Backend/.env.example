DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
CORS_ORIGINS=https://campus-market-gamma-eight.vercel.app
# Mode-specific keys are used by wallet deposits, product checkout, and payouts; the legacy key is a test-mode fallback.
CHAPA_SECRET_KEY=replace-with-your-value
# Use the exact Chapa Webhooks dashboard Secret hash. Live mode reads CHAPA_LIVE_WEBHOOK_SECRET below.
CHAPA_WEBHOOK_SECRET=replace-with-your-value
CHAPA_MODE=test
CHAPA_TEST_SECRET_KEY=replace-with-chapa-test-secret
CHAPA_LIVE_SECRET_KEY=replace-with-chapa-live-secret
CHAPA_TEST_WEBHOOK_SECRET=replace-with-chapa-test-webhook-secret
CHAPA_LIVE_WEBHOOK_SECRET=replace-with-chapa-live-webhook-secret
# Generate a distinct Fernet key for payout-account encryption; never reuse a Chapa key.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=generate-a-fernet-key-and-store-it-securely
PAYOUT_TIMEOUT_HOURS=24
PAYOUT_MIN_AMOUNT_ETB=100.00
PAYOUT_DAILY_LIMIT_ETB=1000000.00
PAYOUT_MAX_REQUESTS_PER_HOUR=10
PAYOUT_ADMIN_APPROVAL_THRESHOLD_ETB=5000.00
OPENAI_API_KEY=replace-with-your-value
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto
AI_TIMEOUT=30
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
SESSION_SECRET=replace-with-a-long-random-value
# Comma-separated trusted proxy IPs/CIDRs. X-Forwarded-For is only used from these proxies.
TRUSTED_PROXY_IPS=
# Optional path to a local MaxMind GeoIP2/GeoLite2 City database (.mmdb).
GEOIP_DATABASE_PATH=replace-with-a-long-random-value
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-and-store-it-securely
# Must never be true in production.
DISABLE_ADMIN_2FA=false
# Emergency password-only access for the sole active admin when global 2FA is required.
# Keep false except during a supervised recovery; turn it off immediately afterward.
ADMIN_2FA_BYPASS=false
# Enable sub-admin creation, activation, deactivation, and deletion.
ADMIN_SUB_ADMINS_ENABLED=false
PAY_MAX_FAILED_ATTEMPTS=5
PAY_LOCK_MINUTES=15
DISPUTE_WINDOW_HOURS=24
MAX_TOTAL_ADMINS=3
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# Required when the frontend and backend use different HTTPS domains. Local HTTP loopback cookies remain non-Secure.
COOKIE_SECURE=true
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
MICROSOFT_CLIENT_ID=replace-with-microsoft-app-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-app-client-secret
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/login
CHAPA_PUBLIC_KEY=replace-with-your-value
# Set BASE_URL to the HTTPS tunnel for local Chapa callbacks. In production, set
# PUBLIC_BASE_URL to the public HTTPS backend URL; webhook and return paths are derived.
BASE_URL=https://your-public-tunnel.example
PUBLIC_BASE_URL=
# Required for administrator login email verification and other SMTP notifications.
# Use a Gmail app password (without spaces), not the account password.
SENDER_EMAIL=replace-with-your-value
SENDER_PASSWORD=replace-with-your-value
# Development only: clear forgot-password rate-limit history at backend startup.
PASSWORD_RESET_CLEAR_RATE_LIMITS_ON_STARTUP=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
EMAIL_DEV_LOG_OTP=
GOOGLE_API_KEY=replace-with-your-value
GOOGLE_CSE_ID=replace-with-your-value